# Database
DATABASE_PATH=./data/system.db
TENANT_DATABASES_PATH=./data/tenants

# JWT
JWT_SECRET=<generated-secure-secret>
JWT_EXPIRATION=7d

# API Key (REQUIRED - the app refuses requests without it)
BACKGROUND_PROCESSOR_API_KEY=<generated-secure-key>

# Shopify OAuth app credentials (from the Shopify Dev Dashboard app).
# Shop domains and inventory locations are NOT env vars: each tenant's admin
# enters their store domain in the UI connect flow, and the primary location
# is detected automatically during OAuth.
SHOPIFY_CLIENT_ID=<your-app-client-id>
SHOPIFY_CLIENT_SECRET=<your-app-client-secret>
SHOPIFY_SCOPES=read_products,write_products,write_files,read_files,read_locations,write_inventory,read_inventory
SHOPIFY_REDIRECT_URI=https://{your-domain}/api/auth/shopify/callback
SHOPIFY_API_VERSION=2025-10

# Server
PORT=3000
LOG_LEVEL=info  # error | warn | info | debug

# Shopify App Pricing billing enforcement (leave unset in dev: app treats
# every tenant as subscribed until a Partner API token is configured)
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_APP_ID=
SHOPIFY_APP_HANDLE=disc-golf-inventory
