# NextJS API
NEXTJS_API_URL=http://localhost:3000
NEXTJS_API_KEY=<same-as-nextjs-BACKGROUND_PROCESSOR_API_KEY>

# Polling
POLLING_INTERVAL_MS=5000

# Shopify (API version only - each tenant's offline token, shop domain and
# location come from GET /api/queries/shopify-connections)
SHOPIFY_API_VERSION=2025-10

# Image processing (centers the disc on a light blue canvas)
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_BACKGROUND_HEX=#ADD8E6
IMAGE_CANVAS_SIZE=1024
IMAGE_MARGIN_PX=48
IMAGE_TRIM_THRESHOLD=20
